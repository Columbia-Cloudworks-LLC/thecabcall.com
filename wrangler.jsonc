{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thecabcall",
  "main": "src/worker.ts",
  "compatibility_date": "2025-04-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cabcall-db",
      "database_id": "094cf69c-0fe3-409b-a871-06f3610a28a6",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "AUDIO_BUCKET",
      "bucket_name": "cabcall-audio"
    }
  ],
  "triggers": {
    "crons": [
      "0 */6 * * *",
      "0 12 * * 5"
    ]
  }
}
